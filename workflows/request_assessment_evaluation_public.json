    {
      "parameters": {
        "jsCode": "const expected = $('Canonical Request').first().json;\nconst coreResult = $('Request Assessment Core').first().json;\n\nconst actual = coreResult.output;\nconst retrievedSources = coreResult.retrieved_sources || [];\n\nconst retrievalPass = retrievedSources.some(\n  source => source === expected.expected_source\n);\n\nconst decisionPass =\n  actual.risk_level === expected.expected_risk_level &&\n  actual.needs_human_review === expected.expected_human_review;\n\nreturn [\n  {\n    json: {\n      id: expected.id,\n      actual_sources: retrievedSources.join('; '),\n      actual_risk_level: actual.risk_level,\n      actual_human_review: actual.needs_human_review,\n      actual_recommendation: actual.recommendation,\n      retrieval_pass: retrievalPass,\n      decision_pass: decisionPass\n    }\n  }\n];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
