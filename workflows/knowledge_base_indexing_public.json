{
  "name": "Knowledge Base Indexing",
  "nodes": [
    {
      "parameters": {
        "jsCode": "const items = $input.all();\nconst output = [];\n\nfor (let i = 0; i < items.length; i++) {\n\n  const buffer = await this.helpers.getBinaryDataBuffer(i, 'data');\n  const fileText = buffer.toString('utf8');\n\n  const match = fileText.match(\n    /^---\\s*\\n([\\s\\S]*?)\\n---\\s*\\n([\\s\\S]*)$/\n  );\n\n  let metadata = {};\n  let content = fileText;\n\n  if (match) {\n    const yamlText = match[1];\n    content = match[2].trim();\n\n    for (const line of yamlText.split('\\n')) {\n      const separatorIndex = line.indexOf(':');\n\n      if (separatorIndex === -1) continue;\n\n      const key = line.slice(0, separatorIndex).trim();\n\n      let value = line\n        .slice(separatorIndex + 1)\n        .trim()\n        .replace(/^[\"']|[\"']$/g, '');\n\n      metadata[key] = value;\n    }\n  }\n\n  output.push({\n    json: {\n      content,\n      metadata\n    }\n  });\n}\n\nreturn output;"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        144,
        16
      ],
      "id": "de0bbcb3-a514-46eb-97c9-24947f4b18cb",
      "name": "Parse Document Metadata"
    },
    {
      "parameters": {
        "jsCode": "const items = $input.all();\nconst output = [];\n\nfor (const item of items) {\n  const content = item.json.content;\n  const metadata = item.json.metadata;\n\n  const sections = content\n    .split(/(?=^##\\s+)/gm)\n    .map(section => section.trim())\n    .filter(Boolean);\n\n  for (const section of sections) {\n    // Remove Markdown headings temporarily.\n    const bodyText = section\n      .replace(/^#{1,6}\\s+.+$/gm, '')\n      .trim();\n\n    // Skip sections that contain only a heading.\n    if (bodyText.length === 0) {\n      continue;\n    }\n\n    const headingMatch = section.match(/^##\\s+(.+)$/m);\n\n    const sectionTitle = headingMatch\n      ? headingMatch[1].trim()\n      : metadata.title;\n\n    output.push({\n      json: {\n        content: section,\n        metadata: {\n          ...metadata,\n          section_title: sectionTitle\n        }\n      }\n    });\n  }\n}\n\nreturn output;"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        368,
        16
      ],
      "id": "c62d2508-2b6c-4c3d-8551-7b1b6db3a75b",
