    {
      "parameters": {
        "jsCode": "const implementation =\n  $('Assemble Implementation Proposal').first().json;\n\nconst rag =\n  $('Request Assessment Core').first().json.output;\n\nconst sources = implementation.source_documents || [];\n\nconst descriptionText = `\n*Recommendation:*\n${implementation.recommendation}\n\n*Implementation approach:*\n${implementation.implementation_approach}\n\n*Review status:*\n${implementation.review_status}\n\n${implementation.review_comment\n  ? `*Reviewer note:*\\n${implementation.review_comment}`\n  : \"\"}\n\n*Internal sources consulted:*\n${sources.map(source => `- ${source}`).join('\\n')}\n`.trim();\n\nreturn {\n  summary: implementation.task_title,\n\n  labels: rag.jira_labels || [],\n\n  description_text: descriptionText\n};"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
